# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dev-server.log

# env files (can opt-in for committing if needed)
# `.env.example` SÍ se sube: es la documentación de qué variables
# hacen falta y de qué es cada una. Sin él, nadie sabe qué poner en
# Coolify, y un servicio sin SERVICE_SECRET parece que funciona
# mientras no.canjea ningún ticket.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
# La excepción de `!.env.example` va DESPUÉS de estas líneas: las
# reglas de .gitignore se aplican en orden y, sin repetirla aquí,
# estos `.env*` volverían a tapar la excepción de arriba.
.env*
!.env.example
.freebuff/
.env.local
.env

# archivos internos (no van a GitHub)
AGENTS.md
CLAUDE.md

supabase/.temp/

# Salida de la prueba de humo (`npm run smoke:auto`).
# `capturas/` son PNG de pantallas con datos del cliente de prueba, así que
# además de ruido, no deberían subirse: se regeneran en cada ejecución.
capturas/
logs/
