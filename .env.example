# =========================================================
# Nexo Studio — configuración del bot (wweb)
# ---------------------------------------------------------
# Copia a .env.local y rellena. Las que no se ponen salen con su
# valor de desarrollo, y el bot funciona pero talking con datos de
# mentira, que es peor que no funcionar.
# =========================================================

# ---- Supabase ----
# El bot usa la MISMA base que el panel. No son dos bases: el bot
# no tiene usuarios propios, usa la identidad de Supabase Auth del
# panel y las políticas RLS de la misma tabla.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=

# ---- Ticket firmado ----
# COMPARTIDA con el panel, carácter por carácter. El panel firma el
# ticket en `#ticket=` y el bot lo verifica aquí. Si difieren, el
# canje responde 401 y no dice por qué.
#
# Lo que NO puede compartirse es SESSION_SECRET: cada servicio firma
# su cookie con la suya, y si compartieran, una cookie válida en el
# panel valdría en el bot. Eso es justo lo que el host-only evita.
SERVICE_SECRET=

# ---- Panel de Nexo Studio ----
# Dónde está el panel, para los enlaces de vuelta ("Volver al
# panel", "Ir al panel"). Sin NEXT_PUBLIC_, porque estas pantallas
# se pintan en el navegador y ahí no existe el process.env del
# servidor. No es un secreto: es una dirección pública.
NEXT_PUBLIC_PANEL_URL=https://TU-PANEL

# ---- Webhook de Evolution ----
# Evolution envía aquí los mensajes. El mismo valor va en el panel
# de Evolution, en la cabecera x-webhook-secret.
WEBHOOK_SECRET=

# ---- Cron ----
# Para disparar los recordatorios de la agenda a mano:
#   curl -H "x-cron-secret: $CRON_SECRET" .../api/appointments/reminder
# Sin esto, los recordatorios no salen solos.
CRON_SECRET=

# ---- Otros ----
# URL pública del bot, para los enlaces que genera él mismo.
APP_URL=https://TU-BOT

# Zona horaria del negocio: manda en "hoy", "mañana" y en los
# recordatorios. Sin esto usa America/Argentina/Buenos_Aires.
BUSINESS_TIMEZONE=America/Argentina/Buenos_Aires

NODE_ENV=development
PORT=3000

# ---- Evolution API ----
# Solo se usan desde los scripts de administración (db/), no en cada
# petición. En caliente, el bot lee el servidor de la tabla
# `evolution_servers`: por eso no hacen falta aquí.
EVOLUTION_API_URL=
EVOLUTION_API_KEY=